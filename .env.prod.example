# ============================================================================
# chinphotos Production Environment Template (.env.prod)
# Copy this file to .env.prod on the production VPS and replace all secrets.
# ============================================================================

# Domain & Image Tag
DOMAIN=chinphotos.vn
GITHUB_REPOSITORY=username/chinphotos
TAG=latest

# MongoDB Root & Least-Privilege Application User
MONGO_INITDB_ROOT_USERNAME=root_admin
MONGO_INITDB_ROOT_PASSWORD=REPLACE_WITH_STRONG_ROOT_PASSWORD
MONGO_INITDB_DATABASE=photographer
MONGO_APP_USER=photographer_app
MONGO_APP_PASSWORD=REPLACE_WITH_STRONG_APP_PASSWORD

# Application Connection URI (uses least-privilege app user)
MONGODB_URI=mongodb://photographer_app:REPLACE_WITH_STRONG_APP_PASSWORD@mongo:27017/photographer?authSource=photographer

# JWT & Origins
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_SECRET
CLIENT_URL=https://chinphotos.vn
ADMIN_URL=https://chinphotos.vn/admin

# Storage Configuration
STORAGE_DRIVER=local
UPLOAD_DIR=/app/uploads
PUBLIC_UPLOAD_URL=/uploads

# Optional SMTP Configuration for Inquiry Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=hello@chinphotos.vn
SMTP_PASS=REPLACE_WITH_SMTP_APP_PASSWORD
SMTP_FROM="chinphotos Studio <hello@chinphotos.vn>"
