# Docker Compose Environment Variables
NODE_ENV=development
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=root_password
MONGO_APP_USER=app
MONGO_APP_PASSWORD=app_password
MONGO_DB=photographer

# Server environment
PORT=5000
MONGODB_URI=mongodb://app:app_password@mongo:27017/photographer?authSource=photographer
STORAGE_DRIVER=local
UPLOAD_DIR=/app/uploads
PUBLIC_UPLOAD_URL=http://localhost:5000/uploads
JWT_SECRET=photographer_dev_secret_key_change_in_production_123456
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Client environment
VITE_API_URL=http://localhost:5000/api
VITE_SITE_URL=http://localhost:5173

# Admin environment
VITE_USE_MOCK=false
VITE_BASE=/
